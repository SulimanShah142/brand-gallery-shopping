{
  "expo": {
    "name": "Brand Gallery Shopping",
    "slug": "user-app",
    "version": "1.0.41",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.jpeg",
    "scheme": "userapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "edgeToEdgeEnabled": true,
    "predictiveBackGestureEnabled": false,
    "usesCleartextTraffic": true,
    "owner": "shah-suliman",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slliman.userapp",
      "associatedDomains": [
        "applinks:brand-gallery-deep-linking.vercel.app"
      ],
      "buildNumber": "33"
    },

    "android": {
      "package": "com.slliman.userapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.jpeg",
        "backgroundColor": "#FFFFFF"
      },
      "notification": {
        "icon": "./assets/ic_stat_onesignal_default.png",
        "color": "#000000"
      },
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "brand-gallery-deep-linking.vercel.app",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "brand-gallery-deep-linking.vercel.app",
              "pathPrefix": "/products"
            }
          ]
        }
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.jpeg"
    },

    "plugins": [
      "expo-updates",
      [
        "react-native-fbsdk-next",
        {
          "appID": "1626553048908896",
          "clientToken": "e6721d94108a7ff29c409ad386c6b86a",
          "displayName": "Brand Gallery Shopping",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Brand Gallery to access your location for delivery."
        }
      ],
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      "./plugins/with-onnxruntime",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "smallIcons": ["./assets/ic_stat_onesignal_default.png"],
          "smallIconAccentColor": "#000000"
        }
      ]
    ],

    "extra": {
      "oneSignalAppId": "1e89f5fe-bc90-4462-b4ab-f03a3e561c8d",
      "router": {},
      "eas": {
        "projectId": "074c6e26-27f5-4c47-b086-5ee0955bd13b"
      }
    },

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/074c6e26-27f5-4c47-b086-5ee0955bd13b"
    }
  }
}
