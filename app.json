    "icon": "./assets/images/app-icon.jpeg",
    "scheme": "userapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "edgeToEdgeEnabled": true,
    "predictiveBackGestureEnabled": false,
    "usesCleartextTraffic": true,
    "owner": "slliman-sarwari",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slliman.userapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:brand-gallery-deep-linking.vercel.app",
        "applinks:brand-gallery-deep-linking.vercel.app"
      ],
      "buildNumber": "33",
      "infoPlist": {
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ]
      }
    },
    "android": {
      "package": "com.slliman.userapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.jpeg",
        "backgroundColor": "#FFFFFF"
      },
      "notification": {
        "icon": "./assets/ic_stat_onesignal_default.png",
        "color": "#000000"
      },
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "brand-gallery-deep-linking.vercel.app",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "brand-gallery-deep-linking.vercel.app",
              "pathPrefix": "/products"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "brand-gallery-deep-linking.vercel.app",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "brand-gallery-deep-linking.vercel.app",
              "pathPrefix": "/products"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.jpeg"
    },
    "plugins": [
      "expo-updates",
      [
        "react-native-fbsdk-next",
        {
          "appID": "1626553048908896",
          "clientToken": "e6721d94108a7ff29c409ad386c6b86a",
          "displayName": "Brand Gallery Shopping",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Brand Gallery to access your location for delivery."
        }
      ],
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "28.1.13356709",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            },
            "extraProguardRules": "-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod\n-keep class kotlin.Metadata { *; }\n-keep class * implements expo.modules.kotlin.records.Record { *; }\n-keep class * extends expo.modules.kotlin.sharedobjects.SharedObject"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      "./plugins/with-onnxruntime",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "smallIcons": [
            "./assets/ic_stat_onesignal_default.png"
          ],
          "smallIconAccentColor": "#000000"
        }
      ]
    ],
    "extra": {
      "oneSignalAppId": "1e89f5fe-bc90-4462-b4ab-f03a3e561c8d",
      "router": {},
      "eas": {
        "projectId": "2e341b3d-bcfd-4db0-a651-513f4c084752",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.slliman.userapp.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.slliman.userapp.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/2e341b3d-bcfd-4db0-a651-513f4c084752"
    }
  }
